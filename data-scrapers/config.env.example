# Data Scraper Configuration
# Copy this file to config.env and fill in your credentials

# ENTSO-E Transparency Platform
# Get your API key from: https://transparency.entsoe.eu/
ENTSOE_API_KEY=your_entsoe_api_key_here

# EPEX Spot
# Note: EPEX Spot data may require a subscription or may be accessible through ENTSO-E
EPEX_SPOT_API_KEY=your_epex_api_key_here
EPEX_SPOT_API_URL=https://api.epexspot.com

# Database Configuration (if storing data in a database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=energy_data
DB_USER=postgres
DB_PASSWORD=your_db_password

# Data Storage
DATA_DIR=./data
LOG_DIR=./logs

# Scraping Schedule (cron format)
SCRAPING_SCHEDULE=0 */6 * * *  # Every 6 hours

# Timezone
TIMEZONE=Europe/Berlin
